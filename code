#include "raylib.h"
#include <stdio.h>
#include <math.h>

typedef enum GameState
{
    STATE_MENU,
    STATE_GAME,
    STATE_OPTIONS,
    STATE_COUNTDOWN
} GameState;

// add this field to your Character struct:
typedef struct
{
    Texture2D tex;
    Vector2 pos;
    float speed;
    float scale;
    float rotationDeg; // NEW: current rotation in degrees
} Character;

// add this NEW type below Character
typedef struct
{
    Vector2 pos;
    Vector2 vel;
    float rotationDeg;
    float life; // seconds remaining
    bool active;
} Bullet;

typedef struct
{
    Vector2 pos;
    Vector2 vel;
    float rotationDeg;
    bool active;
} Enemy;

// --- Ammo system ---
int maxBullets = 15, currentBullets = 15;
bool reloading = false;
float reloadTime = 2.5f, reloadTime2 = 0.0f;

// tweak as you like
#define MAX_BULLETS 128
#define BULLET_SPEED 700.0f
#define BULLET_LIFE 1.5f
#define BULLET_W 12.0f
#define BULLET_H 4.0f
#define MAX_ENEMIES 6
#define ENEMY_SPEED 175.0f
#define PLAYER_MAX_HP 3
#define PLAYER_MAX_HEALTH 3
int playerHealth = PLAYER_MAX_HEALTH;
bool playerInvulnerable = false;
float playerInvulnTime = 1.0f; // seconds of i-frames after hit
float playerInvulnTimer = 0.0f;

Enemy enemies[MAX_ENEMIES] = {0};

int main(void)
{
    // Initialization
    //--------------------------------------------------------------------------------------
    const int screenWidth = 1600;
    const int screenHeight = 900;

    InitWindow(screenWidth, screenHeight, "raylib [core] example - basic window");
    SetExitKey(KEY_NULL); // from first code: disable ESC auto-exit
    SetTargetFPS(60);     // Set our game to run at 60 frames-per-second
    //--------------------------------------------------------------------------------------

    GameState state = STATE_MENU;
    int menuIndex = 0; // 0 = "Start", 1 = "Quit"
    int selectedplayers = 0;
    bool playerConfirmed = false;
    bool gameStarted = false;

    // Countdown variables
    bool countdownActive = false;
    float countdown = 3.0f;
    double countdownStartTime = 0.0;

    // === Timer variables (changed to double for precision) ===
    double gameTimer = 300.0; // 5 minutes = 300 seconds
    bool timerActive = false;

    const char *names[3] = {"CEDRIC", "AMIEL", "IAN"};
    int positions[3] = {400, 700, 1000};
    Texture2D Enemy = LoadTexture("assets/enemy.png");
    Texture2D PlayerImages[3];
    PlayerImages[0] = LoadTexture("assets/ced.png");
    PlayerImages[1] = LoadTexture("assets/amiel.png");
    PlayerImages[2] = LoadTexture("assets/ian.png");

    Texture2D PlayerIngameImage[3];
    PlayerIngameImage[0] = LoadTexture("assets/ced_top.png");
    PlayerIngameImage[1] = LoadTexture("assets/amiel_top.png");
    PlayerIngameImage[2] = LoadTexture("assets/ian_top.png");

    InitAudioDevice();
    Sound Confirm = LoadSound("assets/Confirm.wav");
    Sound Select = LoadSound("assets/Select.wav");
    Sound Countdown = LoadSound("assets/Countdown.wav");
    Sound Reload = LoadSound("assets/reload.wav");
    Sound Shooting = LoadSound("assets/Shooting.wav");

    Texture2D Background = LoadTexture("assets/bgver2.png");

    Character player;
    bool playerInitialized = false;
    Bullet bullets[MAX_BULLETS] = {0};
    // --- Shooting delay variables ---
    float fireCooldown = 0.0f;      // counts down until we can shoot again
    const float FIRE_DELAY = 0.20f; // seconds between shots (change for faster/slower fire)

    // Main game loop
    while (!WindowShouldClose()) // Detect window close button or ESC key
    {
        // =========================
        // UPDATE
        // =========================
        if (state == STATE_MENU)
        {
            // --- Keyboard (2-item menu like original) ---
            if (IsKeyPressed(KEY_DOWN) || IsKeyPressed(KEY_S))
            {
                if (menuIndex != 1)
                {
                    menuIndex = 1;
                    PlaySound(Select);
                }
            }

            if (IsKeyPressed(KEY_UP) || IsKeyPressed(KEY_W))
            {
                if (menuIndex != 0)
                {
                    menuIndex = 0;
                    PlaySound(Select);
                }
            }

            // --- Mouse setup: recompute centered positions like in DRAW (from first code) ---
            int rw = GetRenderWidth();
            int rh = GetRenderHeight();
            int fontSize = 40;

            int startWidth = MeasureText("START GAME", fontSize);
            int StartX = (rw - startWidth) / 2;
            int StartY = rh / 2;

            int quitWidth = MeasureText("QUIT GAME", fontSize);
            int quitX = (rw - quitWidth) / 2;
            int quitY = StartY + 60;

            const int padX = 24, padY = 10;
            Rectangle btnStart = (Rectangle){StartX - padX, StartY - padY, startWidth + 2 * padX, fontSize + 2 * padY};
            Rectangle btnQuit = (Rectangle){quitX - padX, quitY - padY, quitWidth + 2 * padX, fontSize + 2 * padY};

            Vector2 m = GetMousePosition();
            bool hoverStart = CheckCollisionPointRec(m, btnStart);
            bool hoverQuit = CheckCollisionPointRec(m, btnQuit);

            if (hoverStart)
                menuIndex = 0;
            if (hoverQuit)
                menuIndex = 1;

            // --- Activate (keyboard) ---
            if (IsKeyPressed(KEY_ENTER))
            {
                if (menuIndex == 0)
                {
                    state = STATE_GAME;
                    // reset game flow state on entering GAME
                    playerConfirmed = false;
                    gameStarted = false;
                    countdownActive = false;
                    countdown = 3.0f;
                    playerInitialized = false;
                    currentBullets = maxBullets;
                    reloading = false;
                    // reset timer when entering game-selection screen
                    gameTimer = 300.0;
                    timerActive = false;
                    playerHealth = PLAYER_MAX_HEALTH;
                    playerInvulnerable = false;
                    playerInvulnTimer = 0.0f;

                    PlaySound(Confirm);
                    WaitTime(0.15f);
                }
                else if (menuIndex == 1)
                {
                    break; // quit
                }
            }

            // --- Activate (mouse) ---
            if (hoverStart && IsMouseButtonPressed(MOUSE_LEFT_BUTTON))
            {
                state = STATE_GAME;
                playerConfirmed = false;
                gameStarted = false;
                countdownActive = false;
                countdown = 3.0f;
                playerInitialized = false;
                currentBullets = maxBullets;
                reloading = false;
                gameTimer = 300.0;
                timerActive = false;
            }
            if (hoverQuit && IsMouseButtonPressed(MOUSE_LEFT_BUTTON))
            {
                break;
            }
        }
        else if (state == STATE_GAME)
        {
            if (IsKeyPressed(KEY_ESCAPE))
            {
                state = STATE_MENU;
                playerConfirmed = false;
                gameStarted = false;
                countdownActive = false;
                countdown = 3.0f;
                playerInitialized = false;
                currentBullets = maxBullets;
                reloading = false;
                timerActive = false; // stop timer
                playerHealth = PLAYER_MAX_HEALTH;
                playerInvulnerable = false;
                playerInvulnTimer = 0.0f;

                PlaySound(Confirm);
            }

            if (!playerConfirmed)
            {
                if (IsKeyPressed(KEY_RIGHT))
                {
                    selectedplayers = (selectedplayers + 1) % 3;
                    PlaySound(Select);
                }
                if (IsKeyPressed(KEY_LEFT))
                {
                    selectedplayers = (selectedplayers - 1 + 3) % 3;
                    PlaySound(Select);
                }

                if (IsKeyPressed(KEY_ENTER))
                {
                    playerConfirmed = true;
                    PlaySound(Confirm);
                }
            }
            else if (playerConfirmed && !gameStarted)
            {
                // When player presses ENTER again, switch to countdown screen
                if (IsKeyPressed(KEY_ENTER))
                {
                    state = STATE_COUNTDOWN;
                    countdownActive = true;
                    countdownStartTime = GetTime();
                    PlaySound(Confirm);
                    PlaySound(Countdown);
                }
            }

            // --- Live gameplay (only when game started and player is ready) ---
            if (gameStarted && playerInitialized)
            {
                float dt = GetFrameTime();
                if (playerInvulnerable)
                {
                    playerInvulnTimer -= dt;
                    if (playerInvulnTimer <= 0.0f)
                    {
                        playerInvulnerable = false;
                    }
                }
                // --- update fire cooldown ---
                if (fireCooldown > 0.0f)
                    fireCooldown -= dt;

                // === update game timer if active ===
                if (timerActive && gameTimer > 0.0)
                {
                    gameTimer -= dt;
                    if (gameTimer <= 0.0)
                    {
                        gameTimer = 0.0;
                        timerActive = false; // stop at zero (you may add game-over logic here)
                    }
                }

                // movement input
                Vector2 move = (Vector2){0, 0};
                if (IsKeyDown(KEY_A) || IsKeyDown(KEY_LEFT))
                    move.x -= 1.0f;
                if (IsKeyDown(KEY_D) || IsKeyDown(KEY_RIGHT))
                    move.x += 1.0f;
                if (IsKeyDown(KEY_W) || IsKeyDown(KEY_UP))
                    move.y -= 1.0f;
                if (IsKeyDown(KEY_S) || IsKeyDown(KEY_DOWN))
                    move.y += 1.0f;

                if (move.x != 0 || move.y != 0)
                {
                    float len = sqrtf(move.x * move.x + move.y * move.y);
                    move.x /= len;
                    move.y /= len;
                }

                player.pos.x += move.x * player.speed * dt;
                player.pos.y += move.y * player.speed * dt;

                // size once; reuse
                float pw = player.tex.width * player.scale;
                float ph = player.tex.height * player.scale;

                // clamp inside window
                if (player.pos.x < 0)
                    player.pos.x = 0;
                if (player.pos.y < 0)
                    player.pos.y = 0;
                if (player.pos.x > screenWidth - pw)
                    player.pos.x = screenWidth - pw;
                if (player.pos.y > screenHeight - ph)
                    player.pos.y = screenHeight - ph;

                float hitScale = 0.8f; // adjust between 0.5–1.0 (smaller = easier)
                float shrinkX = pw * (1.0f - hitScale) * 0.5f;
                float shrinkY = ph * (1.0f - hitScale) * 0.5f;
                Rectangle playerRect = {
                    player.pos.x + shrinkX,
                    player.pos.y + shrinkY,
                    pw * hitScale,
                    ph * hitScale};

                // --- AIM: rotate player to face mouse ---
                Vector2 mouse = GetMousePosition();
                Vector2 center = (Vector2){player.pos.x + pw * 0.5f, player.pos.y + ph * 0.5f};
                Vector2 dir = (Vector2){mouse.x - center.x, mouse.y - center.y};
                float dlen = sqrtf(dir.x * dir.x + dir.y * dir.y);
                if (dlen > 0.0001f)
                {
                    dir.x /= dlen;
                    dir.y /= dlen;
                }

                player.rotationDeg = atan2f(dir.y, dir.x) * (180.0f / PI) - 90.0f;

                // --- SHOOT bullets ---
                if ((IsMouseButtonPressed(MOUSE_LEFT_BUTTON) || IsMouseButtonDown(MOUSE_LEFT_BUTTON)) &&
                    fireCooldown <= 0.0f && !reloading && currentBullets > 0)
                {
                    PlaySound(Shooting);
                    for (int i = 0; i < MAX_BULLETS; i++)
                    {
                        if (!bullets[i].active)
                        {
                            float muzzleDist = fmaxf(pw, ph) * 0.5f;
                            Vector2 spawn = (Vector2){center.x + dir.x * muzzleDist, center.y + dir.y * muzzleDist};

                            bullets[i].pos = spawn;
                            bullets[i].vel = (Vector2){dir.x * BULLET_SPEED, dir.y * BULLET_SPEED};
                            bullets[i].rotationDeg = atan2f(dir.y, dir.x) * (180.0f / PI);
                            bullets[i].life = BULLET_LIFE;
                            bullets[i].active = true;

                            fireCooldown = FIRE_DELAY;
                            currentBullets--; // consume one bullet
                            break;
                        }
                    }
                }

                // --- UPDATE bullets ---
                for (int i = 0; i < MAX_BULLETS; i++)
                {
                    if (!bullets[i].active)
                        continue;
                    bullets[i].pos.x += bullets[i].vel.x * dt;
                    bullets[i].pos.y += bullets[i].vel.y * dt;
                    bullets[i].life -= dt;

                    if (bullets[i].life <= 0.0f ||
                        bullets[i].pos.x < -50 || bullets[i].pos.x > screenWidth + 50 ||
                        bullets[i].pos.y < -50 || bullets[i].pos.y > screenHeight + 50)
                    {
                        bullets[i].active = false;
                    }
                }
                // Spawn multiple enemies at once
                int enemiesToSpawn = GetRandomValue(1, 2);
                for (int e = 0; e < enemiesToSpawn; e++)
                {
                    for (int i = 0; i < MAX_ENEMIES; i++)
                    {
                        if (!enemies[i].active)
                        {
                            int corner = GetRandomValue(0, 3);
                            switch (corner)
                            {
                            case 0:
                                enemies[i].pos = (Vector2){0, 0};
                                break;
                            case 1:
                                enemies[i].pos = (Vector2){screenWidth - 40, 0};
                                break;
                            case 2:
                                enemies[i].pos = (Vector2){0, screenHeight - 40};
                                break;
                            case 3:
                                enemies[i].pos = (Vector2){screenWidth - 40, screenHeight - 40};
                                break;
                            }
                            enemies[i].active = true;
                            break; // go to next enemy slot
                        }
                    }
                }

                // Move enemies toward player
                for (int i = 0; i < MAX_ENEMIES; i++)
                {
                    if (!enemies[i].active)
                        continue;
                    Vector2 dir = {
                        (player.pos.x + player.tex.width * player.scale / 2) - enemies[i].pos.x,
                        (player.pos.y + player.tex.height * player.scale / 2) - enemies[i].pos.y};
                    float len = sqrtf(dir.x * dir.x + dir.y * dir.y);
                    if (len > 0)
                    {
                        dir.x /= len;
                        dir.y /= len;
                    }

                    enemies[i].pos.x += dir.x * ENEMY_SPEED * dt;
                    enemies[i].pos.y += dir.y * ENEMY_SPEED * dt;
                    enemies[i].rotationDeg = atan2f(dir.y, dir.x) * RAD2DEG + 90.0f;
                }

                // --- Enemy hits player ---
                for (int i = 0; i < MAX_ENEMIES; i++)
                {
                    if (!enemies[i].active)
                        continue;

                    float enemyScale = 0.2f;
                    float enemyW = Enemy.width * enemyScale;
                    float enemyH = Enemy.height * enemyScale;

                    Rectangle enemyRect = {
                        enemies[i].pos.x - enemyW * 0.5f,
                        enemies[i].pos.y - enemyH * 0.5f,
                        enemyW,
                        enemyH};

                    if (!playerInvulnerable && CheckCollisionRecs(playerRect, enemyRect))
                    {
                        // enemy touched player -> damage
                        playerHealth--;
                        playerInvulnerable = true;
                        playerInvulnTimer = playerInvulnTime;

                        enemies[i].active = false;

                        // check death
                        if (playerHealth <= 0)
                        {
                            // simple game-over: back to menu & reset (you can later make a real screen)
                            state = STATE_MENU;
                            playerConfirmed = false;
                            gameStarted = false;
                            countdownActive = false;
                            playerInitialized = false;
                            currentBullets = maxBullets;
                            reloading = false;
                            timerActive = false;
                            playerHealth = PLAYER_MAX_HEALTH;
                        }
                    }
                }

                // --- Bullet vs Enemy collision ---
                float enemyScale = 0.2f;
                float enemyW = Enemy.width * enemyScale;
                float enemyH = Enemy.height * enemyScale;

                for (int i = 0; i < MAX_BULLETS; i++)
                {
                    if (!bullets[i].active)
                        continue;

                    // bullet hitbox (centered)
                    Rectangle bulletRect = {
                        bullets[i].pos.x - BULLET_W * 0.5f,
                        bullets[i].pos.y - BULLET_H * 0.5f,
                        BULLET_W,
                        BULLET_H};

                    for (int j = 0; j < MAX_ENEMIES; j++)
                    {
                        if (!enemies[j].active)
                            continue;

                        // enemy hitbox (centered)
                        Rectangle enemyRect = {
                            enemies[j].pos.x - enemyW * 0.5f,
                            enemies[j].pos.y - enemyH * 0.5f,
                            enemyW,
                            enemyH};

                        if (CheckCollisionRecs(bulletRect, enemyRect))
                        {
                            // 💥 Collision detected!
                            enemies[j].active = false; // enemy dies
                            bullets[i].active = false; // bullet disappears
                            break;                     // stop checking this bullet
                        }
                    }
                }

                // Reload bullets ---
                if (reloading)
                {
                    reloadTime2 -= dt;
                    if (reloadTime2 <= 0.0f)
                    {
                        currentBullets = maxBullets;
                        reloading = false;
                    }
                }
                else
                {
                    if (IsKeyPressed(KEY_R) && currentBullets < maxBullets)
                    {
                        PlaySound(Reload);
                        reloading = true;
                        reloadTime2 = reloadTime;
                    }
                }
            }
        }

        else if (state == STATE_COUNTDOWN)
        {
            double elapsed = GetTime() - countdownStartTime;

            if (elapsed < 1.0)
                countdown = 3;
            else if (elapsed < 2.0)
                countdown = 2;
            else if (elapsed < 3.0)
                countdown = 1;
            else if (elapsed < 4.0)
                countdown = 0; // show START!
            else
            {
                countdownActive = false;
                gameStarted = true;
                state = STATE_GAME;

                player.tex = PlayerIngameImage[selectedplayers];
                player.rotationDeg = 0.0f;
                player.scale = 150.0f / player.tex.width;
                player.speed = 350.0f;
                player.pos.x = (screenWidth - player.tex.width * player.scale) * 0.5f;
                player.pos.y = (screenHeight - player.tex.height * player.scale) * 0.6f;
                playerInitialized = true;
                currentBullets = maxBullets;
                reloading = false;

                // === Start the 5-minute timer (double) ===
                gameTimer = 300.0;
                timerActive = true;
            }
        }

        // =========================
        // DRAW
        // =========================
        BeginDrawing();
        ClearBackground(RAYWHITE);

        if (state == STATE_MENU)
        {
            int rw = GetRenderWidth();
            int rh = GetRenderHeight();

            int titleSize = 100;
            int titleWidth = MeasureText("OUT OF TOUCH", titleSize);
            int titleX = (rw - titleWidth) / 2;
            DrawText("OUT OF TOUCH", titleX, rh / 4, titleSize, BLACK);

            int fontSize = 40;
            const int padX = 24, padY = 10;

            int startWidth = MeasureText("START GAME", fontSize);
            int StartX = (rw - startWidth) / 2;
            int StartY = rh / 2;
            Rectangle btnStart = (Rectangle){StartX - padX, StartY - padY, startWidth + 2 * padX, fontSize + 2 * padY};

            int quitWidth = MeasureText("QUIT GAME", fontSize);
            int quitX = (rw - quitWidth) / 2;
            int quitY = StartY + 60;
            Rectangle btnQuit = (Rectangle){quitX - padX, quitY - padY, quitWidth + 2 * padX, fontSize + 2 * padY};

            Vector2 m = GetMousePosition();
            if (CheckCollisionPointRec(m, btnStart))
                DrawRectangleRec(btnStart, (Color){220, 220, 220, 255});
            if (CheckCollisionPointRec(m, btnQuit))
                DrawRectangleRec(btnQuit, (Color){220, 220, 220, 255});

            Color startcolor = (menuIndex == 0) ? RED : DARKGRAY;
            Color quitcolor = (menuIndex == 1) ? RED : DARKGRAY;

            DrawText("START GAME", StartX, StartY, fontSize, startcolor);
            DrawText("QUIT GAME", quitX, quitY, fontSize, quitcolor);

            int insfontSize = 20;
            const char *tip = "USE ARROWS UP/DOWN OR MOUSE // PRESS ENTER/CLICK TO SELECT";
            int instructionsWidth = MeasureText(tip, insfontSize);
            int insX = (rw - instructionsWidth) / 2;
            int insY = quitY + 60;
            DrawText(tip, insX, insY, insfontSize, GRAY);
        }
        else if (state == STATE_GAME)
        {
            if (gameStarted)
            {
                DrawTextureEx(Background, (Vector2){0, 0}, 0.0f, 1.3f, WHITE);

                if (playerInitialized)
                {
                    Rectangle src = (Rectangle){0, 0, player.tex.width, player.tex.height};
                    Rectangle dst = (Rectangle){
                        player.pos.x + (player.tex.width * player.scale) * 0.5f,
                        player.pos.y + (player.tex.height * player.scale) * 0.5f,
                        player.tex.width * player.scale,
                        player.tex.height * player.scale};
                    Vector2 origin = (Vector2){dst.width * 0.5f, dst.height * 0.5f};

                    DrawTexturePro(player.tex, src, dst, origin, player.rotationDeg, WHITE);
                    // --- Display ammo info ---
                    if (reloading)
                    {
                        DrawText("Reloading...", 50, 50, 30, RED);
                    }
                    else
                    {
                        DrawText(TextFormat("Bullets: %d / %d", currentBullets, maxBullets), 50, 50, 30, DARKBLUE);
                        if (currentBullets == 0)
                            DrawText("Out of bullets! Press R to reload!", 50, 90, 20, GRAY);
                    }
                    // --- time remaining ---
                    {
                        int minutes = (int)(gameTimer / 60.0);
                        int seconds = (int)fmod(gameTimer, 60.0);
                        char timeremaining[32];
                        sprintf(timeremaining, "Time remaining: %02d:%02d", minutes, seconds);
                        int tw = MeasureText(timeremaining, 30);
                        DrawText(timeremaining, screenWidth - tw - 20, 40, 30, DARKGREEN);
                    }
                }
                else
                {
                    DrawText("Loading player...", 630, 400, 30, RED);
                }

                // --- draw bullets ---
                for (int i = 0; i < MAX_BULLETS; i++)
                {
                    if (!bullets[i].active)
                        continue;

                    Rectangle bdst = (Rectangle){bullets[i].pos.x, bullets[i].pos.y, BULLET_W, BULLET_H};
                    Vector2 borg = (Vector2){BULLET_W * 0.5f, BULLET_H * 0.5f};
                    DrawRectanglePro(bdst, borg, bullets[i].rotationDeg, BLUE);
                }
                // Draw enemies
                for (int i = 0; i < MAX_ENEMIES; i++)
                {
                    if (!enemies[i].active)
                        continue;
                    float scale = 0.2f;
                    Vector2 origin = {Enemy.width * scale / 2, Enemy.height * scale / 2};
                    DrawTexturePro(Enemy,
                                   (Rectangle){0, 0, Enemy.width, Enemy.height},
                                   (Rectangle){enemies[i].pos.x, enemies[i].pos.y, Enemy.width * scale, Enemy.height * scale}, origin, enemies[i].rotationDeg, WHITE);
                }
                // --- Draw health ---
                for (int i = 0; i < PLAYER_MAX_HEALTH; i++)
                {
                    Color c = (i < playerHealth) ? RED : (Color){150, 150, 150, 255};
                    DrawRectangle(50 + i * 30, 100, 20, 20, c); // simple squares as hearts
                }
                EndDrawing();
                continue;
            }

            DrawText("GAME RUNNING!", 610, 100, 40, DARKBLUE);
            DrawText("Press ESC to return to menu", 620, 160, 20, GRAY);

            for (int i = 0; i < 3; i++)
            {
                Color color = (i == selectedplayers) ? RED : DARKBLUE;
                float scale = 150.0f / PlayerImages[i].width * 0.8f;
                DrawTextureEx(PlayerImages[i], (Vector2){positions[i] + 10, 290}, 0.0f, scale, WHITE);
                DrawRectangleLines(positions[i], 300, 150, 150, color);
                int textWidth = MeasureText(names[i], 40);
                DrawText(names[i], positions[i] + 75 - textWidth / 2, 460, 40, color);
            }

            if (playerConfirmed && !gameStarted)
            {
                DrawText(TextFormat("You chose: %s", names[selectedplayers]), 620, 600, 30, BLACK);
                DrawText("Press ENTER again to start", 620, 640, 20, GRAY);
            }
        }
        else if (state == STATE_COUNTDOWN)
        {
            ClearBackground(WHITE);

            char countdownText[10];
            if (countdown > 0)
                sprintf(countdownText, "%d", (int)countdown);
            else
                sprintf(countdownText, "START!");

            int fontSize = 150;
            int textWidth = MeasureText(countdownText, fontSize);
            int textX = (GetScreenWidth() - textWidth) / 2;
            int textY = (GetScreenHeight() - fontSize) / 2;

            DrawText(countdownText, textX, textY, fontSize, RED);
        }

        EndDrawing();
    }
    UnloadSound(Select);
    UnloadSound(Confirm);
    UnloadSound(Countdown);
    UnloadSound(Reload);
    UnloadSound(Shooting);

    CloseAudioDevice();
    UnloadTexture(Background);

    CloseWindow();
    return 0;
}
