#include "raylib.h"
#include <stdio.h>

typedef enum GameState
{
    STATE_MENU,
    STATE_GAME,
    STATE_COUNTDOWN
} GameState;

int main(void)
{
    // Initialization
    //--------------------------------------------------------------------------------------
    const int screenWidth = 1600;
    const int screenHeight = 900;

    InitWindow(screenWidth, screenHeight, "raylib [core] example - basic window");

    SetTargetFPS(60); // Set our game to run at 60 frames-per-second

    //--------------------------------------------------------------------------------------
    GameState state = STATE_MENU;
    int menuIndex = 0; // 0 = "Start", 1 = "Quit"
    int selectedplayers = 0;
    bool playerConfirmed = false;
    bool gameStarted = false;

    // Countdown variables
    bool countdownActive = false;
    float countdown = 3.0f;
    double countdownStartTime = 0.0;

    const char *names[3] = {"CEDRIC", "AMIEL", "IAN"};
    int positions[3] = {400, 700, 1000};
    Texture2D PlayerImages[3];
    PlayerImages[0] = LoadTexture("C:/Users/henry/Downloads/ced.png");
    PlayerImages[1] = LoadTexture("C:/Users/henry/Downloads/ian.png");
    PlayerImages[2] = LoadTexture("C:/Users/henry/Downloads/amiel.png");

    // Main game loop
    while (!WindowShouldClose()) // Detect window close button or ESC key
    {
        if (state == STATE_MENU)
        {
            if (IsKeyPressed(KEY_DOWN) || IsKeyPressed(KEY_S))
                menuIndex = 1;
            if (IsKeyPressed(KEY_UP) || IsKeyPressed(KEY_W))
                menuIndex = 0;

            if (IsKeyPressed(KEY_ENTER))
            {
                if (menuIndex == 0)
                    state = STATE_GAME;
            }
            else if (menuIndex == 1)
            {
                if (IsKeyPressed(KEY_ENTER))
                {
                    break; // this exits the program
                }
            }
        }
        else if (state == STATE_GAME)
        {
            if (IsKeyPressed(KEY_ESCAPE))
            {
                state = STATE_MENU;
                playerConfirmed = false;
                gameStarted = false;
                countdownActive = false;
                countdown = 3.0f;
            }

            if (!playerConfirmed)
            {
                if (IsKeyPressed(KEY_RIGHT))
                    selectedplayers = (selectedplayers + 1) % 3;
                if (IsKeyPressed(KEY_LEFT))
                    selectedplayers = (selectedplayers - 1 + 3) % 3;

                if (IsKeyPressed(KEY_ENTER))
                    playerConfirmed = true;
            }
            else if (playerConfirmed && !gameStarted)
            {
                // When player presses ENTER again, switch to countdown screen
                if (IsKeyPressed(KEY_ENTER))
                {
                    state = STATE_COUNTDOWN;
                    countdownActive = true;
                    countdownStartTime = GetTime();
                }
            }
        }
        else if (state == STATE_COUNTDOWN)
        {
            double elapsed = GetTime() - countdownStartTime;

            if (elapsed < 1.0)
                countdown = 3;
            else if (elapsed < 2.0)
                countdown = 2;
            else if (elapsed < 3.0)
                countdown = 1;
            else if (elapsed < 4.0)
                countdown = 0; // show START!
            else
            {
                countdownActive = false;
                gameStarted = true;
                state = STATE_GAME; // proceed to actual game after countdown
            }
        }

        //-----------------------DRAWING AREA OF FUNCTIONS(BACKBONE)---------------------//
        BeginDrawing();

        ClearBackground(RAYWHITE);

        if (state == STATE_MENU)
        {
            DrawText("OUT OF TOUCH", 600, 150, 50, BLACK);

            Color startcolor = (menuIndex == 0) ? RED : DARKGRAY;
            Color quitcolor = (menuIndex == 0) ? DARKGRAY : RED;

            DrawText("START GAME", 650, 300, 40, startcolor);
            DrawText("QUIT GAME", 670, 360, 40, quitcolor);

            DrawText("USE ARROWS UP AND DOWN TO CHOOSE AND PRESS ENTER TO SELECT", 420, 450, 20, GRAY);
        }
        else if (state == STATE_GAME)
        {
            if (gameStarted)
            {
                ClearBackground(RAYWHITE);
                // DITO NA MAG START YUNG MISMONG LARO
                DrawText("GAME STARTED!", 630, 400, 50, DARKGREEN);
                EndDrawing();
                continue;
            }

            DrawText("GAME RUNNING!", 610, 100, 40, DARKBLUE);
            DrawText("Press ESC to return to menu", 620, 160, 20, GRAY);

            for (int i = 0; i < 3; i++)
            {
                Color color = (i == selectedplayers) ? RED : DARKBLUE;
                float scale = 150.0f / PlayerImages[i].width * 0.8f;
                DrawTextureEx(PlayerImages[i], (Vector2){positions[i] + 10, 290}, 0.0f, scale, WHITE);
                DrawRectangleLines(positions[i], 300, 150, 150, color);
                int textWidth = MeasureText(names[i], 40);
                DrawText(names[i], positions[i] + 75 - textWidth / 2, 460, 40, color);
            }

            if (playerConfirmed && !gameStarted)
            {
                DrawText(TextFormat("You chose: %s", names[selectedplayers]), 620, 600, 30, BLACK);
                DrawText("Press ENTER again to start", 620, 640, 20, GRAY);
            }
        }
        else if (state == STATE_COUNTDOWN)
        {
            // Separate countdown screen
            ClearBackground(WHITE);

            char countdownText[10];
            if (countdown > 0)
                sprintf(countdownText, "%d", (int)countdown);
            else
                sprintf(countdownText, "START!");

            int fontSize = (countdown > 0) ? 200 : 100;
            Color color = (countdown > 0) ? RED : GREEN;
            int textWidth = MeasureText(countdownText, fontSize);
            DrawText(countdownText, screenWidth / 2 - textWidth / 2, screenHeight / 2 - fontSize / 2, fontSize, color);
        }

        EndDrawing();
        //----------------------------------------------------------------------------------
    }

    // De-Initialization
    //--------------------------------------------------------------------------------------
    for (int i = 0; i < 3; i++)
        UnloadTexture(PlayerImages[i]);
    CloseWindow(); // Close window and OpenGL context
    //--------------------------------------------------------------------------------------

    return 0;
}
