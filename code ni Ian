#include <stdio.h>
#include <string.h>

#define MAX 50

struct Student {
    char name[20];
    int score;
};

int main() {
    struct Student s[MAX], tempstudent;
    int numOfStudents = 0, addStudents, i, j;
    int highest, lowest, sum;
    float average;
    float grade;
    char status[10];
    int choice;

    // READ INPUT FILE
    FILE *inputFile = fopen("C:\\Users\\henry\\OneDrive\\Desktop\\FINALS 2\\students.txt", "r");

    if (inputFile != NULL) {
        printf("Existing file opened successfully!\n");
        while (fscanf(inputFile, "%s %d", s[numOfStudents].name, &s[numOfStudents].score) != EOF) {
            numOfStudents++;
        }
        fclose(inputFile);
    } else {
        printf("No existing file found.\n");
    }

    // MENU
    do {
        printf("\n--- MENU ---\n");
        printf("1. Add Students\n");
        printf("2. Delete Student\n");
        printf("3. Display Current Students\n");
        printf("4. Exit\n");
        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch (choice) {
            case 1:  // ADD STUDENTS
                printf("\nHow many students do you want to add? ");
                scanf("%d", &addStudents);
                if (numOfStudents + addStudents > MAX) {
                    printf("BSIT-1C ONLY HAS 50 STUDENTS!\n");
                    break;
                }
                for (i = numOfStudents; i < numOfStudents + addStudents; i++) {
                    printf("\nStudent %d name: ", i + 1);
                    scanf("%s", s[i].name);
                    printf("Student %d score: ", i + 1);
                    scanf("%d", &s[i].score);
                }
                numOfStudents += addStudents;
                printf("\nAdded!\n");  // confirmation message
                break;

            case 2:  // DELETE STUDENT
                if (numOfStudents == 0) {
                    printf("No students to delete.\n");
                    break;
                }
                char delName[20];
                printf("Enter the name of the student to delete: ");
                scanf("%s", delName);
                int found = 0;
                for (i = 0; i < numOfStudents; i++) {
                    if (strcmp(s[i].name, delName) == 0) {
                        found = 1;
                        for (j = i; j < numOfStudents - 1; j++) {
                            s[j] = s[j + 1];
                        }
                        numOfStudents--;
                        printf("%s has been deleted.\n", delName);
                        break;
                    }
                }
                if (!found) printf("Student not found.\n");
                break;

            case 3:  // DISPLAY CURRENT STUDENTS
                if (numOfStudents == 0) {
                    printf("No students available.\n");
                    break;
                }

                // SORTING ALPHABETICALLY
                for (i = 0; i < numOfStudents - 1; i++) {
                    for (j = i + 1; j < numOfStudents; j++) {
                        if (strcmp(s[i].name, s[j].name) > 0) {
                            tempstudent = s[i];
                            s[i] = s[j];
                            s[j] = tempstudent;
                        }
                    }
                }

                // Compute highest, lowest, average
                highest = lowest = s[0].score;
                sum = 0;
                for (i = 0; i < numOfStudents; i++) {
                    if (s[i].score > highest) highest = s[i].score;
                    if (s[i].score < lowest) lowest = s[i].score;
                    sum += s[i].score;
                }
                average = (float)sum / numOfStudents;

                // Display TUP Grading System
                printf("\nNames\tScore\tGrade\tStatus\n");
                for (i = 0; i < numOfStudents; i++) {
                    if (s[i].score >= 99) grade = 1.00;
                    else if (s[i].score >= 96) grade = 1.25;
                    else if (s[i].score >= 93) grade = 1.50;
                    else if (s[i].score >= 90) grade = 1.75;
                    else if (s[i].score >= 87) grade = 2.00;
                    else if (s[i].score >= 84) grade = 2.25;
                    else if (s[i].score >= 81) grade = 2.50;
                    else if (s[i].score >= 78) grade = 2.75;
                    else if (s[i].score >= 75) grade = 3.00;
                    else grade = 5.00;

                    if (grade == 5.00) strcpy(status, "Failed");
                    else strcpy(status, "Passed");

                    printf("%s\t%d\t%.2f\t%s\n",
                           s[i].name, s[i].score, grade, status);
                }
                printf("\nHighest Score:\t%d\n", highest);
                printf("Lowest Score:\t%d\n", lowest);
                printf("Average Score: %.1f\n", average);
                break;

            case 4:
                printf("Exiting program...\n");
                break;

            default:
                printf("Invalid choice. Try again.\n");
        }

        } while (choice != 4);

    // SAVING TO OUTPUT FILE
        FILE *pFile = fopen("C:\\Users\\henry\\OneDrive\\Desktop\\FINALS 2\\quiz_summary.txt", "w");

        fprintf(pFile, "Names, Score, Grade, Status:\n");

        for (i = 0; i < numOfStudents; i++) {
            if (s[i].score >= 99) grade = 1.00;
                else if (s[i].score >= 96) grade = 1.25;
                else if (s[i].score >= 93) grade = 1.50;
                else if (s[i].score >= 90) grade = 1.75;
                else if (s[i].score >= 87) grade = 2.00;
                else if (s[i].score >= 84) grade = 2.25;
                else if (s[i].score >= 81) grade = 2.50;
                else if (s[i].score >= 78) grade = 2.75;
                else if (s[i].score >= 75) grade = 3.00;
            else grade = 5.00;

            if (grade == 5.00)
                strcpy(status, "Failed");
            else
                strcpy(status, "Passed");

            fprintf(pFile, "\t%s\t%d\t%.2f\t%s\n",
                    s[i].name, s[i].score, grade, status);
}
            fprintf(pFile, "\nHighest Score:\t%d\n", highest);
            fprintf(pFile, "Lowest Score:\t%d\n", lowest);
            fprintf(pFile, "Average Score: %.1f\n", average);

            fclose(pFile);

        printf("\nSaved SUCCESSFULLY!\n");

    return 0;
}
